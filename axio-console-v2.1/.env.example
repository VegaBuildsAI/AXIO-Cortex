# ═══════════════════════════════════════════════════════════════
# AXIO v2.1 - Configuration Template
# ═══════════════════════════════════════════════════════════════
#
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!
#

# ─── OLLAMA CONFIGURATION ───────────────────────────────────────
# Local Ollama service endpoint
OLLAMA_HOST=http://127.0.0.1:11434
# Local generation budget. AXIO detects and continues an answer if this output
# budget is reached instead of silently dropping the partial response.
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=8192

# Local base model (pull via: ollama pull gemma4:12b). gemma4:12b runs every
# local role; the agentic tier boosts to the Claude API (below).
MODEL_CHAT=gemma4:12b
MODEL_CODING=gemma4:12b
MODEL_REASONING=gemma4:12b
MODEL_FAST=gemma4:12b
MODEL_FALLBACK=gemma4:12b
MODEL_VISION=gemma4:12b

# ─── LOCAL-ONLY MODE ───────────────────────────────────────────
# 0 = hybrid (local base + Claude boost). 1 = run 100% on-device: premium
# routes fall back to the local model and --claude/FORCE_CLAUDE is ignored.
LOCAL_ONLY=0
FORCE_CLAUDE=0

# ─── CLAUDE API CONFIGURATION ───────────────────────────────────
# Required when LOCAL_ONLY=0. Your Claude API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-API-KEY-HERE

# Claude tier — switch in-app with: model opus | model sonnet | model opus max | effort xhigh
#   sonnet = claude-sonnet-4-6  (default — cheaper: $3/$15 per MTok)
#   opus   = claude-opus-4-8    (frontier — $5/$25; switch with: model opus)
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_CHAT=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=16000
# Effort: low | medium | high | xhigh | max  (xhigh is Opus-only)
CLAUDE_EFFORT=high
# Prompt caching (cheaper repeated input, ~0.1x on cached prefix). 1 = on.
PROMPT_CACHE=1

# ─── MEMORY SYSTEM ─────────────────────────────────────────────
# Number of past sessions to recall at session start
# One canonical local mirror for CLI, UI, runtime, Chroma, journals, and outbox.
AXIO_DATA_ROOT=C:\Users\AXIO\.axio
MEMORY_RECALL_RESULTS=5
# Set to 0 to disable session summarization (faster exits)
MEMORY_SUMMARIZE=1
MEMORY_SUMMARY_MODEL=gemma4:12b
# Embedding model — DO NOT CHANGE (768-dim background tokenizer for Tier-2 memory).
# Requires: ollama pull nomic-embed-text
MEMORY_EMBED_MODEL=nomic-embed-text:latest

# ─── SESSION MANAGEMENT ────────────────────────────────────────
# Maximum messages to keep in context before pruning
CONTEXT_MESSAGE_LIMIT=50

# ─── AXIO CODE SKILLS + PYTHON ─────────────────────────────────
# Optional overrides; defaults point to this repository's skills directory.
AXIO_CODE_SKILLS_ROOT=C:\Users\AXIO\AXIO Model Improvement\axio-console-v2.1\skills
AXIO_CODE_SKILL_MAX_CHARS=24000
# Default exposes every registered tool. Set to dynamic only for controlled A/B experiments.
AXIO_CODE_TOOL_ROUTING_MODE=full
# Shared Chat/Cowork/Code multiline prompt size. Oversized input is rejected,
# never cut. AXIO_CODE_INPUT_MAX_CHARS remains accepted as a legacy fallback.
AXIO_INPUT_MAX_CHARS=60000
AXIO_CODE_PYTHON_TIMEOUT=120
AXIO_CODE_NODE_TIMEOUT=300
AXIO_CODE_COMMAND_TIMEOUT=120

# ─── CODE WEB / BROWSER / RETRIEVAL ───────────────────────────
# Local-first search provider. Run SearXNG locally or change this trusted endpoint.
AXIO_SEARXNG_URL=http://127.0.0.1:8080
AXIO_WEB_TIMEOUT=20
AXIO_WEB_MAX_BYTES=2000000
AXIO_WEB_MAX_CHARS=24000
AXIO_BROWSER_TIMEOUT=20
# Derived local caches/indexes. Defaults to %AXIO_DATA_ROOT%\knowledge.
# AXIO_CODE_KNOWLEDGE_DIR=C:\Users\AXIO\.axio\knowledge
AXIO_RETRIEVAL_MAX_FILES=300
AXIO_RETRIEVAL_MAX_CHUNKS=2000

# ─── LOGGING ───────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Docker Postgres live memory backend (AXIO Cortex)
#   postgres = live DB memory (requires the axio-cortex-postgres container)
#   json     = local JSON files (no Docker needed)
AXIO_MEMORY_BACKEND=postgres
AXIO_DB_BIND=127.0.0.1
AXIO_DB_HOST=127.0.0.1
AXIO_DB_PORT=5432
AXIO_DB_NAME=axio_cortex
AXIO_DB_USER=axio
AXIO_DB_PASSWORD=local-dev-password

# ═══════════════════════════════════════════════════════════════
# SETUP INSTRUCTIONS:
# 1. Get your Claude API key: https://console.anthropic.com/account/keys
# 2. Copy this file: cp .env.example .env  (or copy on Windows)
# 3. Edit .env and replace ANTHROPIC_API_KEY with your actual key
# 4. Pull local models: ollama pull gemma4:12b nomic-embed-text
# 5. Run: py axio.py
#
# Security Notes:
# - .env is in .gitignore - never commit it!
# - Keep your API key private
# - Rotate your key if it's ever exposed
# ═══════════════════════════════════════════════════════════════
